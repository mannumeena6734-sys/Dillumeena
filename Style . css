* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Poppins", sans-serif;
    background: #f7f8fc;
    color: #222;
    line-height: 1.6;
}

/* ================= HEADER ================= */

header {
    position: sticky;
    top: 0;
    z-index: 1000;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 14px 7%;
    background: #ffffff;

    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

.logo h2 {
    color: #315bea;
    font-size: 26px;
    font-weight: 700;
}

.logo p {
    color: #666;
    font-size: 14px;
    margin-top: -4px;
}

/* Telegram button */

.join-btn {
    display: inline-block;

    background: #315bea;
    color: white;

    padding: 13px 22px;
    border-radius: 9px;

    text-decoration: none;
    font-weight: 600;
    font-size: 15px;

    transition: 0.3s;
}

.join-btn:hover {
    background: #2147d8;
    transform: translateY(-2px);
}

/* ================= HERO ================= */

.hero {
    max-width: 1100px;
    margin: auto;

    padding: 70px 7% 50px;

    text-align: center;
}

.hero-text {
    max-width: 760px;
    margin: auto;
}

/* Badge */

.badge {
    display: inline-block;

    background: #eaf0ff;
    color: #315bea;

    padding: 9px 20px;
    border-radius: 30px;

    font-weight: 600;
    font-size: 15px;

    margin-bottom: 25px;
}

/* Main heading */

.hero h1 {
    font-size: clamp(38px, 7vw, 64px);
    line-height: 1.15;

    font-weight: 700;

    margin-bottom: 22px;
}

/* Blue heading */

.hero h3 {
    color: #315bea;
    font-size: 24px;
    margin-bottom: 20px;
}

/* Description */

.hero p {
    max-width: 700px;
    margin: auto;

    color: #555;

    font-size: 18px;
    line-height: 1.9;
}

/* Buttons */

.buttons {
    display: flex;
    justify-content: center;
    gap: 18px;

    margin-top: 32px;
}

.apply-btn,
.learn-btn {
    display: inline-block;

    padding: 14px 30px;

    border-radius: 9px;

    text-decoration: none;

    font-weight: 600;
    font-size: 16px;

    transition: 0.3s;
}

.apply-btn {
    background: #315bea;
    color: white;
}

.apply-btn:hover {
    background: #2147d8;
    transform: translateY(-2px);
}

.learn-btn {
    background: white;
    color: #315bea;

    border: 2px solid #315bea;
}

.learn-btn:hover {
    background: #315bea;
    color: white;
}

/* ================= HERO IMAGE ================= */

.hero-image {
    margin: 55px auto 20px;

    max-width: 850px;
}

.hero-image img {
    display: block;

    width: 100%;
    height: 350px;

    object-fit: cover;

    border-radius: 22px;

    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.14);
}

/* ================= FEATURES ================= */

#features {
    padding: 70px 7% 90px;

    background: #f1f3f8;
}

#features > h2 {
    text-align: center;

    font-size: 42px;

    margin-bottom: 45px;
}

/* Cards */

.cards {
    max-width: 1000px;

    margin: auto;

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 25px;
}

.card {
    background: white;

    padding: 35px 30px;

    border-radius: 18px;

    text-align: center;

    box-shadow: 0 7px 25px rgba(0, 0, 0, 0.07);

    transition: 0.3s;
}

.card:hover {
    transform: translateY(-6px);

    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.12);
}

.card h3 {
    color: #315bea;

    font-size: 21px;

    margin-bottom: 12px;
}

.card p {
    color: #666;

    font-size: 16px;
}

/* ================= BLUE CTA FOOTER ================= */

footer {
    background: linear-gradient(
        135deg,
        #315bea,
        #1747e8
    );

    color: white;

    text-align: center;

    padding: 80px 7%;

    border-radius: 0;
}

footer h2 {
    font-size: 38px;

    margin-bottom: 15px;
}

footer p {
    max-width: 600px;

    margin: 0 auto 30px;

    font-size: 17px;

    line-height: 1.8;
}

/* Footer Telegram button */

.footer-btn {
    display: inline-block;

    background: white;

    color: #315bea;

    padding: 15px 42px;

    border-radius: 9px;

    text-decoration: none;

    font-size: 17px;

    font-weight: 700;

    transition: 0.3s;
}

.footer-btn:hover {
    background: #f0f2ff;

    transform: translateY(-3px);
}

/* ================= MOBILE ================= */

@media (max-width: 700px) {

    header {
        padding: 12px 18px;
    }

    .logo h2 {
        font-size: 23px;
    }

    .logo p {
        font-size: 12px;
    }

    .join-btn {
        padding: 11px 15px;
        font-size: 13px;
    }

    .hero {
        padding: 55px 20px 45px;
    }

    .badge {
        font-size: 13px;
        padding: 8px 16px;
    }

    .hero h1 {
        font-size: 42px;
    }

    .hero h3 {
        font-size: 21px;
    }

    .hero p {
        font-size: 16px;
        line-height: 1.8;
    }

    .buttons {
        flex-direction: column;

        gap: 12px;

        padding: 0 20px;
    }

    .apply-btn,
    .learn-btn {
        width: 100%;
    }

    .hero-image {
        margin-top: 40px;
    }

    .hero-image img {
        height: 230px;

        border-radius: 17px;
    }

    #features {
        padding: 55px 20px 65px;
    }

    #features > h2 {
        font-size: 34px;

        margin-bottom: 30px;
    }

    .cards {
        grid-template-columns: 1fr;

        gap: 18px;
    }

    .card {
        padding: 30px 22px;
    }

    footer {
        padding: 65px 20px;
    }

    footer h2 {
        font-size: 32px;
    }

    footer p {
        font-size: 15px;
    }

    .footer-btn {
        width: 80%;

        max-width: 280px;
    }
}
